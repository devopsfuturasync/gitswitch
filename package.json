{
  "name": "gitswitch",
  "productName": "GitSwitch",
  "version": "0.9.0",
  "description": "Cliente Git estilo GitHub Desktop com troca de conta do GitHub em um clique.",
  "author": {
    "name": "Danilo",
    "email": "204404499+devopsfuturasync@users.noreply.github.com"
  },
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node build/make-icon.js",
    "dist": "node build/fetch-vendor.js win32-x64 && electron-builder --win nsis",
    "release": "node build/release.js",
    "vendor": "node build/fetch-vendor.js",
    "dist:mac": "node build/fetch-vendor.js darwin-x64 darwin-arm64 && electron-builder --mac --x64 --arm64",
    "dist:linux": "node build/fetch-vendor.js linux-x64 && electron-builder --linux --x64",
    "release:local": "node build/release-local.js"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.danilogiles.gitswitch",
    "productName": "GitSwitch",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "build/vendor/win32-x64/git",
          "to": "git"
        },
        {
          "from": "build/vendor/win32-x64/gh",
          "to": "gh"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "shortcutName": "GitSwitch",
      "artifactName": "GitSwitch-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "devopsfuturasync",
        "repo": "gitswitch",
        "releaseType": "draft"
      }
    ],
    "asarUnpack": [
      "src/*.js",
      "src/ai-skill.md",
      "src/locales/*.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "extraResources": [
        {
          "from": "build/vendor/darwin-${arch}/gh",
          "to": "gh"
        }
      ],
      "artifactName": "GitSwitch-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "GitSwitch-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage"
        },
        {
          "target": "deb"
        }
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "synopsis": "Git desktop client with one-click GitHub account switching",
      "artifactName": "GitSwitch-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "build/vendor/linux-${arch}/gh",
          "to": "gh"
        }
      ]
    },
    "afterPack": "build/after-pack.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "bin": {
    "gitswitch": "src/cli.js"
  },
  "homepage": "https://github.com/devopsfuturasync/gitswitch"
}
