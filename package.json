{
  "name": "gitswitch",
  "productName": "GitSwitch",
  "version": "0.6.1",
  "description": "Cliente Git estilo GitHub Desktop com troca de conta do GitHub em um clique.",
  "author": "Danilo",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node build/make-icon.js",
    "dist": "node build/fetch-vendor.js && electron-builder --win nsis",
    "release": "node build/release.js",
    "vendor": "node build/fetch-vendor.js"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.danilogiles.gitswitch",
    "productName": "GitSwitch",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "shortcutName": "GitSwitch",
      "artifactName": "GitSwitch-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "devopsfuturasync",
        "repo": "gitswitch",
        "releaseType": "draft"
      }
    ],
    "asarUnpack": [
      "src/*.js",
      "src/ai-skill.md"
    ],
    "extraResources": [
      {
        "from": "build/vendor/git",
        "to": "git"
      },
      {
        "from": "build/vendor/gh",
        "to": "gh"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "bin": {
    "gitswitch": "src/cli.js"
  }
}
